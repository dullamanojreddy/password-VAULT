<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Explicitly asInvoker — never requests elevation for normal operation
             (spec requirement #20). Detecting/inserting into an elevated or
             UAC-secure-desktop target is out of scope by design (see
             IdentityResolver.cs and UiaWatcher.cs), not something we'd need
             admin rights to attempt anyway. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
