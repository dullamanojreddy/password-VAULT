{
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "backend/.venv"
  ],
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows",
  "extraPaths": [
    "backend",
    "backend/.venv/Lib/site-packages"
  ],
  "typeCheckingMode": "basic"
}
